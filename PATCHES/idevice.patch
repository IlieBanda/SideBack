+/// Gets the classic UDID from the RSD handshake's `Properties` dictionary.
+///
+/// This is **not** the same value as `rsd_get_uuid` — that returns the
+/// RSD/ECID-style identifier (`Properties["UUID"]` at the handshake root),
+/// which on modern devices is formatted like a UUID but is a different
+/// value from the device's real UDID. Services that check the UDID against
+/// their own idea of the device's identity (e.g. mobilebackup2, via
+/// `mobilebackup2_set_udid`) need this one instead.
+///
+/// # Arguments
+/// * [`handle`] - A valid RsdHandshake handle
+/// * [`udid`] - Pointer to store the UDID string (caller must free with rsd_free_string)
+///
+/// # Returns
+/// An IdeviceFfiError on error, null on success
+///
+/// # Safety
+/// `handle` must be a valid pointer to a handle allocated by this library
+/// `udid` must be a valid pointer to store the string pointer
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rsd_get_unique_device_id(
+    handle: *mut RsdHandshakeHandle,
+    udid: *mut *mut libc::c_char,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || udid.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+
+    let props = &unsafe { &*handle }.0.properties;
+    let udid_str = match props.get("UniqueDeviceID").and_then(|v| v.as_string()) {
+        Some(u) => u,
+        None => return ffi_err!(IdeviceError::UnexpectedResponse(
+            "no UniqueDeviceID in RSD Properties".to_string()
+        )),
+    };
+    match CString::new(udid_str) {
+        Ok(c_str) => {
+            unsafe { *udid = c_str.into_raw() };
+            null_mut()
+        }
+        Err(_) => ffi_err!(IdeviceError::FfiInvalidString),
+    }
+}
+
