+/// `flock(2)` operation codes accepted by `afc_file_lock`, matching the
+/// values AFC itself uses.
+pub const AFC_LOCK_SHARED: u64 = 5;
+pub const AFC_LOCK_EXCLUSIVE: u64 = 6;
+pub const AFC_LOCK_UNLOCK: u64 = 12;
+
+/// Applies an flock(2)-style lock to an open file
+///
+/// Exists for the iTunes sync lock (`/com.apple.itunes.lock_sync`): holding
+/// it for the duration of a backup tells the device a sync is in progress,
+/// which is what the reference `idevicebackup2` implementation does and
+/// what keeps the device from interleaving its own sync work.
+///
+/// `op` is a plain integer rather than an enum on purpose. cbindgen renders
+/// a `#[repr(u64)]` enum as a C enum plus a same-named `uint64_t` typedef,
+/// and Swift imports the *enum* — whose raw value is 32 bits wide. The
+/// resulting 32-bit argument left the upper half of the register
+/// undefined, so matching it as a `#[repr(u64)]` discriminant was
+/// undefined behaviour and crashed on the first call. Taking a `u64` and
+/// validating it keeps the ABI unambiguous and an unknown value an error
+/// rather than UB.
+///
+/// # Arguments
+/// * [`handle`] - A valid file handle from `afc_file_open`
+/// * [`op`] - One of `AFC_LOCK_SHARED`, `AFC_LOCK_EXCLUSIVE`, `AFC_LOCK_UNLOCK`
+///
+/// # Returns
+/// An IdeviceFfiError on error, null on success
+///
+/// # Safety
+/// `handle` must be a valid pointer to a handle allocated by this library
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn afc_file_lock(
+    handle: *mut AfcFileHandle,
+    op: u64,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let op = match op {
+        AFC_LOCK_SHARED => idevice::afc::opcode::AfcLockOp::SharedLock,
+        AFC_LOCK_EXCLUSIVE => idevice::afc::opcode::AfcLockOp::ExclusiveLock,
+        AFC_LOCK_UNLOCK => idevice::afc::opcode::AfcLockOp::Unlock,
+        _ => return ffi_err!(IdeviceError::FfiInvalidArg),
+    };
+    let res = LOCAL_RUNTIME.block_on(async move {
+        let file = unsafe { &mut (*handle).0 };
+        file.lock(op).await
+    });
+    match res {
+        Ok(_) => null_mut(),
+        Err(e) => ffi_err!(e),
+    }
+}
