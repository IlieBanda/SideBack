-const OUR_WSCALE: u8 = 8;
+// Silo patch: was a hardcoded 8 (advertises window = 65534 << 8 ≈ 16.7 MB,
+// always, via the fixed `u16::MAX - 1` window field below — never actually
+// reflecting how much we can buffer). A lost segment is dropped with no
+// SACK, so *everything* the peer already had in flight above that gap is
+// discarded too. With a ~16.7 MB always-open window the peer can have that
+// much in flight before noticing anything is wrong — one lost packet then
+// means megabytes of retransmission and a multi-minute silent stall waiting
+// on the peer's own RTO, which is exactly what was observed in practice.
+//
+// The right number here is a function of the tunnel's actual RTT (window /
+// RTT = throughput ceiling), which was never measured, not assumed — hence
+// the `rtt=` log line added alongside this. Default of 2 is a deliberately
+// conservative starting point that bounds the blast radius of a single
+// loss; override with `SILO_JKTCP_WSCALE_BITS` (0-14, the raw TCP Window
+// Scale exponent — advertised window is `65534 << bits` bytes, so 2 ≈
+// 256 KB, 8 ≈ 16.7 MB) once real RTT numbers are in hand and a bigger
+// window is known to still be safe. Named `_BITS` on purpose: an earlier
+// version of this constant was called `WSCALE` alone, which reads as "the
+// window size" when it's actually the scale *exponent* — an easy mixup to
+// carry into a future bug.
+//
+// `std::env::var` alone is a dead knob on iOS: there is no shell to export
+// into, and Xcode scheme env vars only apply under Xcode's own launch, not
+// a real install. The Swift side calls `setenv` from a UserDefaults-backed
+// UI setting before the tunnel is created specifically so this reads as
+// something other than a debug-only constant in disguise.
+fn our_wscale() -> u8 {
+    std::env::var("SILO_JKTCP_WSCALE_BITS")
+        .ok()
+        .and_then(|v| v.parse::<u8>().ok())
+        .filter(|v| *v <= 14)
+        .unwrap_or(2)
+}
 
